---
import Layout from '../../layouts/Layout.astro';
import Heading from '../../components/Heading.astro';
import { articles, href, dateLabel } from '../../lib/content';
const entries = await articles();
---
<Layout title="笔记与文章"><Heading eyebrow="Notes / 学习与写作" title="把理解写清楚。" description="通用教程解释可复用的知识；个人日志记录真实的学习过程。经验与观点会明确标记，不代替技术证据。" />
<div class="map-grid" style="grid-template-columns:repeat(auto-fit,minmax(250px,1fr))"><section class="map-family"><span class="eyebrow">EDUCATIONAL ARTICLES</span><h2>通用教程</h2><p>从工程问题解释概念、方法选择与评价。引用原始论文、课程和官方文档，并记录修订。</p></section><section class="map-family"><span class="eyebrow">PERSONAL JOURNAL</span><h2>个人学习记录</h2><p>记录亲自做过的实验、困惑与复盘。尚未进行的实验不写成结果，未学过的课程不写成体验评价。</p></section></div>
<section class="section">{entries.length ? entries.map(e => <a class="resource-row" href={href(`notes/${e.id}/`)}><div><strong>{e.data.title}</strong><small>{dateLabel(e.data.date)} · {e.data.kind==='journal' ? '个人日志' : '通用教程'}{e.data.draft ? ' · 草稿' : ''}</small></div><p>{e.data.description}</p><span class="arrow">→</span></a>) : <div class="note-panel"><div><h3>文章审阅后将在这里出现</h3><p>目前可以阅读算法图鉴与资料导航。内容先核查来源与表述，再加入公开文章列表。</p></div><a class="text-link" href={href('atlas/')}>浏览算法图鉴 →</a></div>}</section>
</Layout>
