---
import Layout from '../layouts/Layout.astro';
import Heading from '../components/Heading.astro';
import { href, articles, algorithms, dateLabel } from '../lib/content';
import { lessons } from '../data/learning';
const notes=await articles(); const methods=await algorithms();
const others=notes.filter(e=>!lessons.some(l=>l.id===e.id));
---
<Layout title="教程与实践"><Heading eyebrow="从理解到动手" title="每个概念，都有一个落点。" description="入门教程串成连续路线；方法图鉴帮助选择方向。先完成一个小实验，再按需要深入。" />
<section class="section tutorial-first"><div class="section-title"><div><h2>共同基础</h2><p>建议按顺序阅读，每篇都含网页演示与可运行代码。</p></div><a class="text-link" href={href('start/')}>查看进度与任务 →</a></div><div class="lesson-grid">{lessons.map((l,i)=><a class="lesson-card" href={href(`notes/${l.id}/`)}><span class="lesson-number">0{i+1}</span><h3>{l.title}</h3><p>{l.output}</p><span class="tiny">{l.duration}</span><span class="card-link">阅读与实践 →</span></a>)}</div></section>
<section class="section"><div class="section-title"><div><h2>方法图鉴</h2><p>先了解任务、动机和边界，再决定是否深入。</p></div><a class="text-link" href={href('atlas/')}>筛选全部方法 →</a></div><div class="method-directory">{methods.map(e=><a href={href(`atlas/${e.id}/`)}><div><strong>{e.data.title}</strong><small>{e.data.family} · {e.data.difficulty}</small></div><span aria-hidden="true">→</span></a>)}</div></section>
{others.length>0 && <section class="section"><h2>更多文章与学习记录</h2>{others.map(e=><a class="resource-row" href={href(`notes/${e.id}/`)}><div><strong>{e.data.title}</strong><small>{dateLabel(e.data.updated||e.data.date)} · {e.data.kind==='journal'?'学习记录':'教程'}</small></div><p>{e.data.description}</p><span class="arrow">→</span></a>)}</section>}
<div class="callout"><strong>已经有明确工程问题？</strong><p>先写出输入、输出、约束和评价预算，再选择一条路径。</p><a class="text-link" href={href('learn/')}>查看进阶学习分支 →</a></div>
</Layout>
