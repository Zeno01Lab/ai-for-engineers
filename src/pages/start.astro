---
import Layout from '../layouts/Layout.astro';
import Heading from '../components/Heading.astro';
import { href } from '../lib/content';
import { lessons } from '../data/learning';
---
<Layout title="Start learning · 开始学习"><Heading eyebrow="QUICK START" title="Start with five minutes." description="从一个预测任务开始，无需安装环境。"/>
<div class="actions"><a class="button" href={href('learn/engineering-ai-foundations/#level-first-step')}>First unit · 开始第一步 →</a><a class="text-link" href={href('map/')}>Knowledge Map · 查看全图 →</a></div>
<section id="practice" class="section"><h2>Practice · 可选入门实验</h2><p class="tiny">实验勾选独立记录；课程进度在学习路径中查看。</p><div class="start-summary"><div><strong><span data-progress-count>0 / 3</span> recorded · 已记录</strong><progress data-progress value="0" max="3" aria-label="入门实验进度"/><p class="tiny" data-progress-message>记录保存在此浏览器。</p></div><button class="text-button" data-reset-progress>Reset · 清除勾选</button></div>
<div class="practice-list">{lessons.map(l=><details class="practice-card" id={l.id}><summary><strong>{l.title}</strong><span>{l.duration}</span></summary><p>{l.question}</p><dl class="lesson-plan"><dt>Read · 阅读</dt><dd><a href={href(`notes/${l.id}/`)}>站内实验说明</a> · <a href={l.resource}>{l.label} ↗</a></dd><dt>Do · 操作</dt><dd>{l.step}</dd><dt>Check · 检查</dt><dd>{l.check}</dd></dl><a class="button" href={href(`notes/${l.id}/`)}>Open experiment · 打开实验 →</a><label class="completion-check"><input type="checkbox" data-complete={l.id}/> 我已完成，并能解释检查问题</label></details>)}</div>
</section>
</Layout>
<script src="../scripts/progress.ts"></script>
