---
import Layout from '../../../layouts/Layout.astro';
import EvidenceNote from '../../../components/map/EvidenceNote.astro';
import { historyNodes, relationsForEvent, type HistoryNode } from '../../../lib/history';
import { algorithms, href } from '../../../lib/content';
import { engineeringQuestions } from '../../../data/engineering';
export function getStaticPaths(){return historyNodes.map(node=>({params:{id:node.id},props:{node}}));}
interface Props { node:HistoryNode; }
const {node}=Astro.props;
const methods=(await algorithms()).filter(m=>node.method_ids.includes(m.id));
const related=relationsForEvent(node.id);
const questions=engineeringQuestions.filter(q=>q.events.includes(node.id)||q.methods.some(id=>node.method_ids.includes(id)));
const crosscheck=node.verification.jrc_report_crosscheck;
const report=crosscheck as {status:string;jrc_report_displayed_year?:number;jrc_report_printed_page?:number;report_url?:string;year_difference_note_zh?:string|null};
---
<Layout title={`${node.title.en} · ${node.title.zh} · ${node.year}`} description={node.problem_or_motivation_zh}>
<header class="history-detail-head"><div class="breadcrumbs"><a href={href('map/?view=history#view-history')}>历史演进</a> / {node.trackLabel}</div><div class="history-detail-title"><div class="large-year"><strong>{node.year}</strong><span>{node.yearLabel}</span></div><div><span class="tag">{node.subjectLabel}</span><h1>{node.title.en}</h1><p class="english-name">{node.title.zh}</p></div></div><p class="history-date-note">这个年份对应上述记录类型，不统一解释为整项技术的发明年。</p>{node.editorNote && <p class="date-editor-note">{node.editorNote}</p>}{report.year_difference_note_zh && <p class="date-editor-note">年份口径：{report.year_difference_note_zh}</p>}</header>
<div class="split"><article><div class="prose"><h2 id="motivation">当时要解决什么问题？</h2><p>{node.problem_or_motivation_zh}</p><h2 id="contribution">这项工作带来了什么？</h2><p>{node.contribution_zh}</p><h2 id="limits">哪些边界需要保留？</h2><p>{node.limitations_or_editorial_caution_zh}</p><h2 id="engineering">今天可以连接哪些工程问题？</h2><p>{node.engineering_connection_zh}</p><p class="tiny">这些联系帮助定位学习方向，不证明该方法在某个工程任务中最优。</p></div>
{methods.length>0 && <section class="history-method-links" id="methods"><h2>理解方法本身</h2><p>历史节点记录代表工作，方法图鉴解释原理、条件与实践入口。</p><div>{methods.map(m=><a href={href(`atlas/${m.id}/`)}><strong>{m.data.english} · {m.data.title}</strong><span>{m.data.description}</span><small>进入方法图鉴 →</small></a>)}</div></section>}
{questions.length>0 && <section class="related"><h3>从工程任务继续探索</h3>{questions.slice(0,4).map(q=><a href={href(`map/?view=engineering#problem-${q.id}`)}>{q.title} →</a>)}</section>}
<section class="event-relations" id="relations"><h2>相关历史节点</h2>{related.length?related.map(r=><div><div class="relation-pair"><a href={href(`map/history/${r.source}/`)}>{r.sourceNode.title.en} · {r.sourceNode.title.zh}</a><span class="relation-mark">{['adoption','support','development'].includes(r.group)?'→':'···'}</span><a href={href(`map/history/${r.target}/`)}>{r.targetNode.title.en} · {r.targetNode.title.zh}</a></div><span class={`relation-type ${r.group}`}>{r.label}</span><p>{r.explanation_zh}</p></div>):<p>这份数据包尚未记录此节点的关系。可以先阅读来源与方法图鉴。</p>}<p class="tiny">关系为编辑性阐释；比较与并行关系不表示直接继承。</p></section>
<section class="references" id="evidence"><h2>来源与年份依据</h2><ol>{node.references.map(ref=><li><a href={ref.url}>{ref.label} ↗</a><small class="reference-scope">{ref.grade} 级 · {ref.sourceKind} · 元数据或摘要核对状态沿用首轮数据包</small></li>)}</ol>{report.status==='checked_against_JRC_historical_report' && <div class="report-crosscheck"><strong>首轮记录：已与 JRC 历史报告对照</strong><p>报告印刷页 {report.jrc_report_printed_page}，记载年份 {report.jrc_report_displayed_year}；当前节点使用 {node.year}（{node.yearLabel}）。</p>{report.report_url && <a class="text-link" href={report.report_url}>查看报告 →</a>}</div>}<EvidenceNote /></section>
<div class="actions"><a class="button" href={href('map/?view=history#view-history')}>返回历史演进 →</a><a class="text-link" href={href('map/sources/')}>来源与编辑标准</a></div>
</article><aside class="side-note toc"><h3>阅读导航</h3><a href="#motivation">当时的问题</a><a href="#contribution">技术贡献</a><a href="#limits">局限与口径</a><a href="#engineering">工程联系</a><a href="#relations">相关节点</a><a href="#evidence">来源与年份依据</a><h3 style="margin-top:25px">寻找学习入口</h3><a href={href('start/')}>三个入门实验 →</a><a href={href('map/?view=structure#view-structure')}>返回知识结构 →</a></aside></div>
</Layout>
