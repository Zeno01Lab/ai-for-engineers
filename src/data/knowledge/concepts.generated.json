    ],
    "draft": false,
    "family": "优化",
    "problem": "每次函数评价昂贵，如何选择更有价值的下一次实验？",
    "english": "Bayesian Optimization",
    "shortEnglish": "Bayesian Opt.",
    "group": "optimization",
    "mapOrder": 1,
    "foundationConceptIds": [
      "optimization",
      "probabilistic-inference",
      "regression"
    ],
    "detailConceptId": "bayesian-optimization",
    "lessonId": null,
    "historyEventIds": [
      "ego"
    ],
    "referenceIds": [
      "res-ax-dev-de6e11afbe",
      "res-pymoo-org-9d6ad8f27d"
    ],
    "atlas": true,
    "sections": {
      "motivation": "网格或随机搜索可能花费大量评价预算。贝叶斯优化利用已有观测，在模型指导下分配下一次评价。它优化的是原始目标函数，不是语言模型的回答。",
      "coreIdea": "建立目标函数的概率代理模型，再用采集函数平衡探索未知区域与利用已有好点。选点、真实评价、更新模型，构成循环。常见代理模型包括高斯过程，但 BO 不限定一种模型。",
      "assumptions": "- 设计空间、目标与约束定义明确。\n- 代理模型的结构与不确定性估计对问题足够有用。\n- 函数评价足够昂贵，使拟合模型和求解采集函数的成本值得付出。",
      "limitations": "高维、混合变量、强非平稳或高度不连续的空间可能增加建模难度。模型不确定性失准会误导选点；不存在对所有问题都最优的 BO 配置。",
      "engineering": "示例：优化一个需要数小时测试的材料配方，或选择需要昂贵仿真的工程设计参数。",
      "alternatives": "评价便宜时先比较随机搜索、差分进化或其他直接搜索；能可靠获得梯度时考虑梯度法。先检查变量规模与建模成本。"
    },
    "references": [
      {
        "title": "Ax",
        "url": "https://ax.dev/"
      },
      {
        "title": "pymoo",
        "url": "https://pymoo.org/"
      }
    ]
