    "detailConceptId": "multi-objective",
    "lessonId": null,
    "historyEventIds": [
      "nsga-ii"
    ],
    "referenceIds": [
      "res-pymoo-org-950177fe9b"
    ],
    "atlas": true,
    "sections": {
      "motivation": "把功耗、速度、重量和成本随意相加，会隐藏偏好与单位差异。多目标优化保留多个目标，让研究者看到取舍；约束规定哪些结果才允许接受。",
      "coreIdea": "对最小化问题，如果一个解在所有目标上不差，并至少一个目标更好，它就支配另一个解。不能被支配的解构成 Pareto 解集。可行性应先依据约束明确判断。",
      "assumptions": "- 目标的方向、单位和可接受约束事先确定。\n- 用于比较的解经过一致的评价条件。\n- 最终选择仍需要工程偏好，算法不会替你决定所有权衡。",
      "limitations": "权重、归一化、参考点与约束处理会改变结果。有限预算得到的是近似前沿；高维目标会使比较和可视化困难。",
      "engineering": "示例：在重量与刚度之间选择机械结构，或在精度与推理延迟之间选择模型部署方案。",
      "alternatives": "有明确偏好时可使用标量化；有硬指标时可把它们设为约束，仅优化一个主要目标。加权和并不能覆盖所有非凸前沿。"
    },
