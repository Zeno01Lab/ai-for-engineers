    "draft": false,
    "family": "优化",
    "problem": "目标相互冲突，怎样找到可行且有意义的性能取舍？",
    "english": "Multi-objective & Constrained Optimization",
    "shortEnglish": "Multi-objective Opt.",
    "group": "optimization",
    "mapOrder": 2,
    "foundationConceptIds": [
      "optimization",
