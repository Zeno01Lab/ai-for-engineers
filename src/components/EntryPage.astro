---
import { render, type CollectionEntry } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import { href, dateLabel, algorithms, articles } from '../lib/content';
import LearningLab from './LearningLab.astro';
import { site } from '../config';
import learningSteps from '../data/learning-path.json';
import { eventsForMethod } from '../lib/history';
interface Props { entry: CollectionEntry<'articles'> | CollectionEntry<'algorithms'>; }
const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const isAlgorithm = entry.collection === 'algorithms';
const section = isAlgorithm ? 'atlas' : 'notes';
const siblings = isAlgorithm ? await algorithms() : await articles();
const related = siblings.filter(e => e.id !== entry.id && e.data.tags.some(t => entry.data.tags.includes(t))).slice(0,3);
const labs:Record<string,'regression'|'classification'|'overfitting'>={'regression-lab':'regression','classification-lab':'classification','overfitting-lab':'overfitting'};
const learningOrder=['regression-lab','classification-lab','overfitting-lab'];
const next=learningOrder[learningOrder.indexOf(entry.id)+1];
const sourcePath=`src/content/${entry.collection}/${entry.id}.md`;
const historical=isAlgorithm?eventsForMethod(entry.id):[];
const course=isAlgorithm?learningSteps.find(s=>s.knowledge.includes(entry.id)):undefined;
---
<Layout title={isAlgorithm&&'english' in entry.data?entry.data.english+' · '+entry.data.title:entry.data.title} description={entry.data.description} noindex={entry.data.draft}>
<header class="article-head"><div class="breadcrumbs"><a href={href(`${section}/`)}>{isAlgorithm ? '算法图鉴' : '学习笔记'}</a> / {isAlgorithm ? 'family' in entry.data && entry.data.family : 'kind' in entry.data && entry.data.kind === 'journal' ? '个人学习记录' : '通用教程'}</div><h1>{isAlgorithm&&'english' in entry.data?entry.data.english:entry.data.title}</h1>{isAlgorithm&&<p class="english-name">{entry.data.title}</p>}<p class="description">{entry.data.description}</p><div class="article-meta"><span>{dateLabel(entry.data.date)}</span><span>{entry.data.difficulty}</span><span>{entry.data.estimatedReadingTime} 分钟阅读</span>{entry.data.updated && <span>修订于 {dateLabel(entry.data.updated)}</span>}</div>{entry.data.tags.map(t => <span class="tag">{t}</span>)}{entry.data.draft && <div class="callout">编辑草稿 · 供本地审阅，正式构建不会收录。</div>}</header>
<div class="split"><article>{labs[entry.id] && <LearningLab kind={labs[entry.id]} />}{course&&<section class="article-course"><a class="button" href={course.materials[0].url} target="_blank" rel="noopener noreferrer">Read · {course.materials[0].label} ↗</a><p><strong>Selected reading · 选读：</strong>{course.materials[0].scope}</p><a class="text-link" href={href(`learn/#level-${course.id}`)}>Checkpoint · 查看任务与进度 →</a></section>}<details class="article-deep-dive"><summary>{isAlgorithm?'Explanation · 原理、应用与边界':'Instructions · 阅读完整实验说明'}</summary><div class="prose"><Content /></div></details>{historical.length>0 && <details class="article-extra"><summary>AI History · 相关历史与证据</summary><section class="method-history" id="history-connections"><h2>相关历史节点</h2><p>代表工作与方法解释分别阅读；节点年份按论文、活动或发布类型标注。</p><div>{historical.map(n=><a href={href(`map/history/${n.id}/`)}><span>{n.year} · {n.yearLabel}</span><strong>{n.title.en} · {n.title.zh} →</strong></a>)}</div></section></details>}{labs[entry.id] && <div class="lesson-finish"><label><input type="checkbox" data-complete={entry.id} /> 我完成了示例，并能解释本篇的检查问题</label><p class="tiny" data-progress-message>进度只保存在当前浏览器。</p><a class="button" href={href(next && learningOrder.includes(entry.id)?`notes/${next}/`:'start/')}>{next && learningOrder.includes(entry.id)?'下一篇教程 →':'返回入门路线 →'}</a></div>}<details class="article-extra"><summary>References · 参考与继续阅读</summary><section class="references"><ol>{entry.data.references.map(ref => <li><a href={ref.url}>{ref.title} ↗</a></li>)}</ol></section></details>{related.length > 0 && <section class="related"><h3>继续探索</h3>{related.map(r => <a href={href(`${section}/${r.id}/`)}>{r.data.title} →</a>)}</section>}<div class="revision-links"><a href={site.repositoryUrl?`${site.repositoryUrl}/issues/new?title=${encodeURIComponent('内容勘误：'+entry.data.title)}`:href('about/#contribute')}>{site.repositoryUrl?'提出勘误 ↗':'修订与反馈方式 →'}</a>{site.repositoryUrl && <a href={`${site.repositoryUrl}/edit/main/${sourcePath}`}>编辑此页 ↗</a>}</div></article><aside class="side-note toc"><h3>阅读导航</h3>{headings.filter(h=>h.depth===2).map(h => <a href={`#${h.slug}`}>{h.text}</a>)}<h3 style="margin-top:25px">先修知识</h3><p>{entry.data.prerequisites.length ? entry.data.prerequisites.join('、') : '无需专门的 AI 基础'}</p>{labs[entry.id] && <a href={href(`examples/${labs[entry.id]}.py`)} download>下载 Python 示例 ↓</a>}</aside></div>
<script src="../scripts/progress.ts"></script>
</Layout>
