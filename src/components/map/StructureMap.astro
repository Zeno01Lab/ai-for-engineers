---
import {knowledgeTerms} from '../../data/knowledge-terms';
import { mapBranches } from '../../data/map';
import { eventsForMethod } from '../../lib/history';
import { href } from '../../lib/content';
---
<div class="view-intro"><h2>先定位概念，再追溯代表工作。</h2><p>方法图鉴解释原理与适用条件；历史节点记录论文、系统或发布的贡献。分支可以交叉。</p></div>
<div class="concept-overview"><div class="concept-parent"><span class="tag">Machine Learning · 机器学习</span><h3>从数据与反馈学习</h3><div class="concept-children"><a href={href('atlas/regression/')}>Supervised Learning · 监督学习<small>Regression 回归 · Classification 分类</small></a><a href={href('atlas/clustering/')}>Unsupervised Learning · 无监督学习<small>Clustering 聚类 · 结构探索</small></a><a href={href('atlas/reinforcement-learning/')}>Reinforcement Learning · 强化学习<small>交互 · 长期决策</small></a></div><p><strong>Deep Learning · 深度学习是一类方法</strong>，可以应用于上述不同任务。<a href={href('atlas/neural-networks/')}>从神经网络理解 →</a></p></div><aside><h3>还有哪些联系？</h3><p>搜索与规划组织行动；概率推理表达未知信息；优化选择输入；智能体组织工具和反馈。</p><p>它们可以和学习模型组合，并非互斥的路线。</p><a class="text-link" href={href('map/?view=engineering#view-engineering')}>从工程问题反向找入口 →</a></aside></div>
<div class="knowledge-tree structure-branches">{mapBranches.map((branch,i)=><details class="tree-branch" open={i===0}><summary><span class="branch-index">0{i+1}</span><span><strong>{branch.title}</strong><small>{branch.question}</small></span></summary><div class="branch-body"><p class="parent-label">{branch.parent}</p><ul>{branch.items.map(item=>{const history=eventsForMethod(item.id);return <li><a href={href(`atlas/${item.id}/`)}><strong>{knowledgeTerms[item.id]?.en||item.label} →</strong><small>{item.label}</small><span>{item.relation}</span><small>{item.example}</small></a>{history.length>0 && <div class="branch-history"><small>代表历史节点</small>{history.slice(0,2).map(n=><a href={href(`map/history/${n.id}/`)}>{n.year} · {n.title.en} · {n.title.zh} ↗</a>)}{history.length>2 && <a href={href(`atlas/${item.id}/#history-connections`)}>查看 {history.length} 个关联节点 →</a>}</div>}</li>;})}</ul></div></details>)}</div>
