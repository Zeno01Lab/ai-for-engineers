---
import { historyNodes, historyRelations, relationGroups } from '../../lib/history';
import { href } from '../../lib/content';
---
<section class="relation-explorer" data-relation-explorer data-url={href('map/relations.json')}><div class="section-title"><div><h2>探索历史节点之间的关系</h2><p>查看采用、组合、比较或并行联系。默认只展开一个节点周围的记录。</p></div></div>
<div class="relation-controls"><label>选择节点<select data-relation-node><option value="">全部关系列表</option>{historyNodes.map(n=><option value={n.id} selected={n.id==='transformer'}>{n.year} · {n.title.zh}</option>)}</select></label><label>关系类型<select data-relation-group><option value="">全部类型</option>{Object.entries(relationGroups).map(([key,label])=><option value={key}>{label}</option>)}</select></label><a class="text-link" href={href('map/sources/#relation-rules')}>如何理解连线？ →</a></div>
<p class="tiny relation-status" data-relation-status role="status">正在准备关系视图；所有记录也可在下方列表阅读。</p><div class="relation-canvas"><svg data-relation-svg viewBox="0 0 920 420" role="group" aria-label="历史节点邻接关系图，可进入节点详情"></svg></div>
<div class="relation-legend"><span class="adoption-line">实线与箭头：采用、组合或回应问题</span><span class="comparison-line">虚线无箭头：比较、家族、背景或并行</span></div><p class="tiny">所有关系是编辑性阐释。箭头表示这条关系的语义方向，不表示“发明了后者”或“全面取代前者”。</p>
<div class="relation-list">{historyRelations.map(r=><article data-relation-item data-source={r.source} data-target={r.target} data-group={r.group}><div class="relation-pair"><a href={href(`map/history/${r.source}/`)}>{r.sourceNode.title.zh}</a><span class={`relation-mark ${r.group}`}>{['adoption','support','development'].includes(r.group)?'→':'···'}</span><a href={href(`map/history/${r.target}/`)}>{r.targetNode.title.zh}</a></div><span class={`relation-type ${r.group}`}>{r.label}</span><p>{r.explanation_zh}</p></article>)}</div>
<noscript><p>可直接阅读上述关系列表；交互图需要 JavaScript。</p></noscript></section>
<script>
type Node={id:string;label:string;english:string;year:number;url:string};type Edge={source:string;target:string;label:string;group:string;explanation:string;directed:boolean};
const container=document.querySelector<HTMLElement>('[data-relation-explorer]');
if(container){const root=container;const select=root.querySelector<HTMLSelectElement>('[data-relation-node]')!;const group=root.querySelector<HTMLSelectElement>('[data-relation-group]')!;const svg=root.querySelector<SVGSVGElement>('[data-relation-svg]')!;const status=root.querySelector('[data-relation-status]')!;const rows=[...root.querySelectorAll<HTMLElement>('[data-relation-item]')];
const ns='http://www.w3.org/2000/svg';function elem(tag:string,attrs:Record<string,string|number>,text?:string){const el=document.createElementNS(ns,tag);for(const[k,v]of Object.entries(attrs))el.setAttribute(k,String(v));if(text)el.textContent=text;return el;}
let data:{nodes:Node[];edges:Edge[]};
function draw(){const focus=select.value;const edges=data.edges.filter(e=>(!focus||e.source===focus||e.target===focus)&&(!group.value||e.group===group.value));rows.forEach(r=>r.hidden=!!((focus&&r.dataset.source!==focus&&r.dataset.target!==focus)||(group.value&&r.dataset.group!==group.value)));svg.replaceChildren();svg.style.display=focus&&edges.length?'':'none';status.textContent=`显示 ${edges.length} / ${data.edges.length} 条关系。${focus&&!edges.length?'这个节点尚无匹配的关系记录。':''}`;if(!focus||!edges.length)return;
const nodes=new Map(data.nodes.map(n=>[n.id,n]));const central=nodes.get(focus)!;const neighborIds=[...new Set(edges.map(e=>e.source===focus?e.target:e.source))];const height=Math.max(250,neighborIds.length*105+30);svg.setAttribute('viewBox',`0 0 920 ${height}`);const cy=height/2;
const defs=elem('defs',{});const marker=elem('marker',{id:'history-edge-arrow',viewBox:'0 0 10 10',refX:9,refY:5,markerWidth:6,markerHeight:6,orient:'auto-start-reverse'});marker.append(elem('path',{d:'M0 0L10 5L0 10Z',fill:'var(--accent)'}));defs.append(marker);svg.append(defs,elem('title',{},`${central.label} 与 ${neighborIds.length} 个节点的编辑性关系`));
function node(n:Node,x:number,y:number,focusNode=false){const link=elem('a',{href:n.url,'aria-label':`查看 ${n.label} 的历史节点`,tabindex:0});link.append(elem('rect',{x,y:y-37,width:260,height:74,rx:7,fill:focusNode?'var(--soft)':'var(--surface)',stroke:'var(--line)'}),elem('text',{x:x+16,y:y-10,fill:'var(--muted)','font-size':13},String(n.year)));const title=n.label.length>16?n.label.slice(0,15)+'…':n.label;const text=elem('text',{x:x+16,y:y+16,fill:'var(--ink)','font-size':17},title);text.append(elem('title',{},n.label));link.append(text);svg.append(link);}
neighborIds.forEach((id,i)=>{const other=nodes.get(id)!;const y=65+i*105;const matched=edges.filter(e=>e.source===id||e.target===id);matched.forEach((e,j)=>{const offset=j*15;const path=elem('path',{d:`M295 ${cy+offset}C420 ${cy+offset},450 ${y+offset},600 ${y+offset}`,fill:'none',stroke:e.directed?'var(--accent)':'var(--muted)','stroke-width':1.8,'stroke-dasharray':e.directed?'0':'6 5'});if(e.directed)path.setAttribute(e.source===focus?'marker-end':'marker-start','url(#history-edge-arrow)');svg.append(path,elem('text',{x:450,y:(cy+y)/2-8+offset,'text-anchor':'middle',fill:'var(--muted)','font-size':12},e.label));});node(other,600,y);});node(central,35,cy,true);}
async function init(){try{const response=await fetch(root.dataset.url!);if(!response.ok)throw new Error();data=await response.json();select.addEventListener('change',draw);group.addEventListener('change',draw);draw();}catch{svg.style.display='none';status.textContent='交互图暂时无法加载，请直接阅读下方的完整关系列表。';}}
init();}
</script>
