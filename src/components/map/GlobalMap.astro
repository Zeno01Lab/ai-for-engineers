---
import {knowledgeMap,historyMap,edgePath} from '../../lib/global-map';
import {layoutEdgeLabels} from '../../lib/map-label-layout.mjs';
import {yearX,historyPeriods} from '../../lib/history-layout.mjs';
import {engineeringQuestions} from '../../data/engineering';
import {href,resources} from '../../lib/content';
import {relationGroups} from '../../lib/history';
import learningSteps from '../../data/learning-path.json';
import {groupResources} from '../../data/map-resources';
interface Props {mode:'structure'|'history';}
const {mode}=Astro.props;
const data=mode==='structure'?knowledgeMap:historyMap;
const marker=`global-${mode}-arrow`;
const captions=layoutEdgeLabels(data);
const resourceEntries=await resources();
const resourceById=new Map(resourceEntries.map(r=>[r.id,r]));
const payload={...data,knowledgeIds:knowledgeMap.nodes.map(n=>n.id),nodes:data.nodes.map(n=>({...n,resources:(mode==='structure'?[]:[...new Set(n.methods.flatMap(m=>groupResources[knowledgeMap.nodes.find(k=>k.id===m.id)?.group||'']||[]))]).slice(0,3).map(id=>{const r=resourceById.get(id)!;return{label:r.data.title,url:href(`resources/#${id}`),directUrl:r.data.url};}),...(mode==='structure'?{resources:learningSteps.filter(s=>s.knowledge.includes(n.id)).flatMap(s=>s.materials.map(m=>({label:m.label,url:href(`learn/#level-${s.id}`),directUrl:m.url,scope:m.scope})))}:{})})),problems:engineeringQuestions.map(p=>({id:p.id,label:p.title,methods:p.methods,events:p.events})),stages:['尚未接触','了解概念','能解释原理','能完成简单实践']};
---
<div class={`global-map ${mode}`} data-global-map={mode}>
 <div class="global-map-heading"><h2>{mode==='structure'?'Knowledge Map · 知识全图':'AI History · 历史全图'}</h2><a class="text-link" href={href(mode==='structure'?'learn/':'map/sources/')}>{mode==='structure'?'Learning Paths · 学习路径 →':'Sources · 来源 →'}</a></div>
 <div class="global-toolbar simple-toolbar"><label class="global-search-label">找一个节点<input type="search" data-map-search placeholder={mode==='structure'?'回归、Transformer、基础…':'1958、AlphaGo、Transformer…'} /></label><details class="map-options"><summary>Filters & help · 筛选与帮助</summary><div class="map-filter-fields"><label>定位节点<select data-map-select><option value="">选择后在图上定位</option>{data.nodes.map(n=><option value={n.id}>{n.year?`${n.year} · `:''}{n.fullLabel||n.label}</option>)}</select></label><label hidden={mode==='structure'}>{mode==='structure'?'学习记录':'定位年代'}<select data-map-goal>{mode==='structure'?<><option value="">课程顺序在学习路径中查看</option></>:<><option value="">完整历史</option><option value="early">1943–1989</option><option value="middle">1990–2011</option><option value="recent">2012–2025</option></>}</select></label><label>工程问题<select data-map-problem><option value="">全局概览</option>{engineeringQuestions.map(p=><option value={p.id}>{p.title}</option>)}</select></label></div>
 <div class="map-discovery-row"><div class="map-lenses" aria-label="探索模式"><button data-map-lens="overview" aria-pressed="true">全览</button><button data-map-lens="focus" aria-pressed="false" disabled>聚焦</button><button data-map-lens="personal" aria-pressed="false">与我有关</button></div><label>路线<select data-map-regionfilter><option value="">全部路线</option>{data.regions.map(r=><option value={r.id}>{r.titleEn?r.titleEn+' · ':''}{r.label}</option>)}</select></label><label>关系<select data-map-edgefilter><option value="">全部关系</option>{mode==='history'?Object.entries(relationGroups).map(([id,label])=><option value={id}>{label}</option>):<><option value="concept">概念联系</option></>}</select></label><span>放大细节时，小地图保留全局坐标。</span></div>
 <details class="map-relation-guide"><summary>怎样读懂这些连线？点击标签可查看完整解释。</summary>{mode==='structure'?<div><p><strong>实线 = 概念怎样配合。</strong>它可能连接任务与方法、学习方式与网络架构，或模型与系统组件。</p><p>例如：监督学习 —「任务：预测数值」— 回归，读作“回归是监督学习中预测数值的一类任务”。</p><p><strong>课程顺序在学习路径中单独展示。</strong>完成选读关卡，会点亮对应的知识点；能力阶段仍由你自评。</p><p>知识图不表达技术诞生顺序；年份和历史工作在“历史演进大图”中查看。</p></div>:<div><p>历史连线解释两项工作的联系。箭头可能表示采用方法、结合组件或回应局限；没有箭头的线用于比较路线、共同思路或背景联系。</p><p>例如：Transformer → BERT，表示 BERT 采用 Transformer 架构；LSTM — Transformer，表示两种序列建模方案的比较，不表示直接继承。</p><p>点击标签可查看两个节点及原有编辑说明；年份依据在各节点详情中查看。</p></div>}</details>
<div class="map-extra-actions"><button data-map-action="labels" aria-pressed="false">All labels · 全部关系标签</button>{mode==='structure'&&<button data-map-action="current" disabled>My position · 我的位置</button>}<button data-map-action="clear-focus">Clear · 清除高亮</button></div></details></div>
 <div class="map-view-controls" aria-label="地图操作"><button data-map-action="out" aria-label="缩小地图">−</button><output data-map-scale>全图</output><button data-map-action="in" aria-label="放大地图">＋</button><button data-map-action="focus" disabled>Focus · 放大所选</button><button data-map-action="fit">Reset · 回到全图</button><button data-map-action="fullscreen">Full screen · 全屏</button></div>
 <div class="global-map-workspace"><div class="global-map-stage"><svg class="global-map-svg" data-map-svg viewBox={`0 0 ${data.width} ${data.height}`} role="group" aria-label={mode==='structure'?'AI 全局知识地图':'AI 历史多路线演进全图'} tabindex="0">
 <defs><marker id={marker} viewBox="0 0 10 10" refX="9" refY="5" markerWidth="5" markerHeight="5" orient="auto-start-reverse"><path d="M0 0L10 5L0 10Z" fill="var(--accent)" /></marker></defs>
 <rect width={data.width} height={data.height} class="canvas-background" />
 {mode==='structure'?<><text x="40" y="44" class="atlas-title">Artificial Intelligence · 人工智能</text><text x="610" y="43" class="atlas-subtitle">表示、推断、学习与行动 · 探索区域存在交叉</text><rect x="405" y="78" width="1110" height="55" rx="8" class="ml-overview"/><text x="425" y="112" class="atlas-subtitle">Machine Learning · 机器学习：任务、神经表示与交互学习相互连接，深度学习可以用于不同任务。</text></>:<><text x="15" y="30" class="atlas-title">AI History · 历史演进</text><text x="310" y="29" class="atlas-subtitle">按年份区间分列，同列按年份堆叠；横距不表示年数，泳道不是继承关系。</text>{historyPeriods.map(p=><text x={yearX(p.start)} y="74" class="time-tick">{p.label}</text>)}</>}
 {data.regions.map(r=><g class={`map-region region-${r.id}`}><rect x={r.x} y={r.y} width={r.width} height={r.height} rx="9"/><text x={r.x+16} y={r.y+27} class="region-title">{r.titleEn||r.label}</text>{(r.note||r.titleEn)&&<text x={r.x+16} y={r.y+49} class="region-note">{r.titleEn?r.label:r.note}</text>}</g>)}
 {mode==='history'&&historyPeriods.map(p=><line x1={yearX(p.start)} x2={yearX(p.start)} y1="90" y2={data.height-20} class="time-grid"/>)}
 <g class="global-edges">{data.edges.map((e,i)=>{const c=captions[i];return <g class={`map-edge ${e.kind}`} data-edge-source={e.source} data-edge-target={e.target} data-edge-kind={e.kind} data-edge-index={i}><path d={edgePath(e,data)} marker-end={e.directed?`url(#${marker})`:undefined}/><path class="caption-leader" d={`M${c.anchorX} ${c.anchorY} L${c.x+c.width/2} ${c.y+c.height/2}`}/><title>{e.statement||e.label}：{e.explanation||'概念联系或建议的学习顺序；不表示历史继承。'}</title></g>;})}</g>
 {data.nodes.map(n=><g class="map-node" data-map-node={n.id} role="button" tabindex="0" aria-label={`${n.year?n.year+' · ':''}${n.fullLabel||n.label}，打开详情`} transform={`translate(${n.x},${n.y})`}><rect width={n.width} height={n.height} rx="6"/><text x="12" y={mode==='structure'?27:21} class="node-label">{n.label}</text><text x="12" y={mode==='structure'?48:52} class="node-subtitle">{n.subtitle}</text>{mode==='history'&&<text x="12" y="37" class="history-node-zh">{(n.titleZh||'').length>13?(n.titleZh||'').slice(0,12)+'…':n.titleZh}</text>}{mode==='structure'&&<><text x={n.width-31} y="15" class="course-light">✧</text><circle cx={n.width-11} cy="10" r="8" class="node-stage"/><text x={n.width-11} y="13" class="stage-digit" data-stage-digit></text><text x={n.width-18} y="56" class="node-current">◆</text></>}<title>{n.fullLabel||n.label} · {n.description}</title></g>)}
 <g class="global-edge-labels">{data.edges.map((e,i)=>{const c=captions[i];return <g class={`map-edge-label ${e.kind}`} data-label-index={i} role="button" tabindex="0" aria-label={`${e.statement||e.label} 点击查看关系解释`} data-caption-x={c.x} data-caption-y={c.y} data-caption-width={c.width} data-caption-height={c.height}><title>{e.statement||e.label} {e.explanation}</title><rect class="edge-label-plate" x={c.x} y={c.y} width={c.width} height={c.height} rx="4"/><text x={c.x+c.width/2} y={c.y+13} class="edge-label">{e.label}</text></g>;})}</g>
 </svg><div class="map-minimap" data-mini-panel><div class="mini-header"><button type="button" class="mini-drag" data-mini-drag aria-label="移动导航小地图：拖动标题栏，或方向键移动，Home 复位" title="拖动移动；方向键移动，Home 复位">⠿ 全局导航</button><button type="button" class="mini-toggle" data-mini-toggle aria-expanded="true" aria-label="折叠导航小地图">−</button></div><div data-mini-body><svg data-map-minimap viewBox={`0 0 ${data.width} ${data.height}`} role="group" aria-label="全局导航小地图，点击定位，方向键平移，Home 返回初始视图" tabindex="0"><rect class="mini-background" width={data.width} height={data.height}/>{data.regions.map(r=><rect class="mini-region" x={r.x} y={r.y} width={r.width} height={r.height} rx="7"/>)}{data.nodes.map(n=><rect data-mini-node={n.id} x={n.x} y={n.y} width={n.width} height={n.height} rx="4"/>)}<rect class="mini-viewport" data-mini-viewport x="0" y="0" width={data.width} height={data.height}/></svg><span class="mini-hint">点击定位 · 标题栏可拖动</span></div></div></div><aside class="global-map-sidebar" hidden data-map-sidebar aria-label="选中节点详情"><button class="sidebar-close" data-map-close aria-label="关闭节点详情">×</button><div data-map-details></div></aside></div>
 <div class="global-map-bottom"><p role="status" data-map-status>{mode==='structure'?`${data.nodes.length} 个概念与方法节点；学习记录初始为空。`:'全图展示 34 个节点与 24 条关系。点击节点高亮相关联系。'}</p><details class="compact-legend"><summary>Legend · 图例</summary><div class="global-legend">{mode==='structure'?<><span>实线：概念怎样配合</span><span>✧ 路径已覆盖 · 点击标签读关系解释</span><span>○ 未接触 · 1 了解 · 2 能解释 · 3 能实践</span><span>◆ 我的位置</span></>:<><span>实线箭头：采用、组合或回应局限</span><span>虚线无箭头：比较、家族、并行或背景</span></>}</div></details></div>
 {mode==='structure'&&<div class="learning-position"><p data-map-progress>课程关卡点亮与能力自评分开保存；完成选读不等于掌握。</p></div>}
 <script type="application/json" data-map-payload set:html={JSON.stringify(payload).replace(/</g,'\u003c')}/>
 <noscript><p>全图可直接阅读。缩放、学习标记与侧栏需要 JavaScript；下方列表提供直接链接。</p></noscript>
</div>
<script>import '../../scripts/global-map';</script>
