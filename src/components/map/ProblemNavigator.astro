---
import {engineeringQuestions} from '../../data/engineering';
import {engineeringProfiles} from '../../data/engineering-profiles';
import steps from '../../data/learning-path.json';
import {algorithms,href} from '../../lib/content';
const names=new Map((await algorithms()).map(a=>[a.id,a.data.english+' · '+a.data.title]));
const payload={questions:engineeringQuestions,profiles:engineeringProfiles,methods:Object.fromEntries([...names].map(([id,label])=>[id,{label,url:href(`atlas/${id}/`),mapUrl:href(`map/?view=structure&node=${id}#view-structure`),learningUnits:steps.filter(s=>s.knowledge.includes(id)).map(s=>({label:s.title,url:href(`learn/#level-${s.id}`)}))}]))};
---
<section class="problem-navigator" data-problem-navigator><div class="navigator-heading"><span class="eyebrow">从问题形式选方法</span><h2>先说清条件，再比较候选。</h2><p>选择目标和已有数据，查看简单基线、候选方法与需要检查的边界。</p></div>
<form data-problem-form><div class="navigator-fields"><label>你要解决什么？<select name="task"><option value="">先选择一个目标</option>{engineeringQuestions.map(q=><option value={q.id}>{q.title}</option>)}</select></label><label>目前有什么数据或反馈？<select name="data"><option value="unknown">尚未明确</option><option value="labeled">有输入与目标标签</option><option value="unlabeled">只有输入，没有标签</option><option value="interaction">可以获得行动反馈</option><option value="rules">有明确规则、模型或约束</option></select></label></div>
<details class="navigator-more"><summary>补充数据结构、预算与风险</summary><div class="navigator-fields"><label>输入结构<select name="structure"><option value="unknown">尚未明确</option><option value="table">表格特征</option><option value="image">图像</option><option value="sequence">文本或时间序列</option><option value="graph">实体及其连接关系</option></select></label><label>数据规模<select name="amount"><option value="unknown">尚未明确</option><option value="small">相对任务，样本较少</option><option value="adequate">已有可划分的样本</option></select></label><label>变量类型<select name="variables"><option value="unknown">尚未明确</option><option value="continuous">连续变量</option><option value="mixed">离散或混合变量</option></select></label><label>维度<select name="dimension"><option value="unknown">尚未明确</option><option value="low">较少变量</option><option value="high">高维设计空间</option></select></label><label>评价噪声<select name="noise"><option value="unknown">尚未明确</option><option value="low">可重复或低噪声</option><option value="noisy">结果存在噪声</option></select></label><label>一次评价的成本<select name="cost"><option value="unknown">尚未明确</option><option value="cheap">便宜，可以多次评价</option><option value="expensive">昂贵，预算紧张</option></select></label><label>目标函数梯度<select name="gradient"><option value="unknown">尚未明确 / 不适用</option><option value="available">可靠可得</option><option value="unavailable">不可得</option></select></label><label>约束<select name="constraints"><option value="unknown">尚未明确</option><option value="hard">必须满足的硬约束</option><option value="soft">可权衡的偏好</option></select></label><label>失败代价<select name="risk"><option value="normal">普通教学或探索</option><option value="high">失败代价较高</option></select></label></div></details>
<button type="reset" class="navigator-reset">清除条件</button></form>
<p data-navigator-status role="status" class="tiny">选择目标后，结果在下方显示；不会记录或上传这些条件。</p><div data-navigator-result hidden></div>
<script type="application/json" data-navigator-data set:html={JSON.stringify(payload).replace(/</g,'\u003c')}/><noscript><p>下方问题卡片提供同样的基线与方法入口。</p></noscript>
</section>
<script>
import {engineeringAdvice} from '../../lib/engineering-selector.mjs';
const root=document.querySelector<HTMLElement>('[data-problem-navigator]');
if(root){const container=root;const form=root.querySelector<HTMLFormElement>('[data-problem-form]')!;const result=root.querySelector<HTMLElement>('[data-navigator-result]')!;const status=root.querySelector('[data-navigator-status]')!;const data=JSON.parse(root.querySelector('[data-navigator-data]')!.textContent!);
function add(tag:string,text:string,cls?:string){const e=document.createElement(tag);e.textContent=text;if(cls)e.className=cls;result.append(e);return e;}
function render(){const values=Object.fromEntries(new FormData(form));const advice=engineeringAdvice(data.questions,data.profiles,values);result.replaceChildren();result.hidden=!advice;if(!advice){status.textContent='选择目标后，结果在下方显示；不会记录或上传这些条件。';return;}status.textContent='已根据所选条件整理候选入口；保留简单基线用于比较。';add('h3',advice.question.title);add('p',advice.question.example,'tiny');add('h4','先做一个简单基线');add('p',advice.profile.baseline);add('h4','候选方法与学习位置');const links=add('div','','navigator-methods');for(const id of advice.methods){const m=data.methods[id];const a=document.createElement('a');a.href=m.url;a.textContent=m.label+' →';const b=document.createElement('a');b.href=m.mapUrl;b.textContent='在全图定位 ↗';const entry=document.createElement('div');entry.append(a,b);for(const unit of m.learningUnits){const learn=document.createElement('a');learn.href=unit.url;learn.textContent='Learn · '+unit.label+' →';entry.append(learn);}links.append(entry);}add('h4','为什么要检查这些条件？');add('p',advice.question.conditions);for(const note of advice.notes)add('p',note,'navigator-condition');add('h4','怎样比较结果？');add('p',advice.profile.check);}
form.addEventListener('submit',e=>e.preventDefault());form.addEventListener('change',render);form.addEventListener('reset',()=>requestAnimationFrame(render));
container.addEventListener('keydown',e=>{if(e.key==='Enter'&&e.target instanceof HTMLInputElement)e.preventDefault();});
}
</script>
